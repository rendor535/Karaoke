### https + register
POST http://localhost:5159/auth/register
Content-Type: application/json

{
  "email": "admin@test.com",
  "password": "admin123",
  "firstName": "Admin",
  "lastName": "Admin"
}

### LOGIN – pobranie tokenu JWT (ADMIN)
POST http://localhost:5159/auth/login
Content-Type: application/json

{
  "email": "admin@test.com",
  "password": "admin123"
}

### LOGIN – pobranie tokenu JWT (USER)
POST http://localhost:5159/auth/login
Content-Type: application/json

{
  "email": "kokos@test.com",
  "password": "suser123"
}
### USER CONTROLLER

### GET /user/me
GET http://localhost:5159/user/me
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..epJFdJa04Ts4sMHWXL9uU8sf9eSusxWfJor9msQXt_o

### GET /user/{id} – admin
GET http://localhost:5159/user/73
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..epJFdJa04Ts4sMHWXL9uU8sf9eSusxWfJor9msQXt_o
### GET /user/{id} – user (tylko swoje ID)
GET http://localhost:5159/user/2
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..rLH5CJTBiJvMia0OWRsycBgFCjawFJw1ixQ_wiPkboM

### PATCH /user/{id} – zmiana roli (ADMIN)
PATCH http://localhost:5159/user/1
Content-Type: application/json
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..epJFdJa04Ts4sMHWXL9uU8sf9eSusxWfJor9msQXt_o

{
  "role": "Superuser"
}

### PATCH /user/{id} – reset hasła 
PATCH http://localhost:5159/user/2
Content-Type: application/json
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..epJFdJa04Ts4sMHWXL9uU8sf9eSusxWfJor9msQXt_o

{
  "newPassword": "Skibidi"
}


### DELETE /user/{id} 
DELETE http://localhost:5159/user/2
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..epJFdJa04Ts4sMHWXL9uU8sf9eSusxWfJor9msQXt_o

